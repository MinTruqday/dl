{
  "title": "DocLib FastAPI Metrics",
  "panels": [
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(http_requests_total)", "legendFormat": "Total Requests"}]
    },
    {
      "title": "Average Response Time (Latency)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m])", "legendFormat": "Avg Response Time (seconds)"}]
    },
    {
      "title": "Requests per Second by Handler",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(http_requests_total[1m])) by (handler)", "legendFormat": "{{handler}}"}]
    }
  ]
}
