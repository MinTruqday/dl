    "cache_patterns": {
      "RATE_LIMITS": ["rate_limit:*"],
      "PASSKEY_CHALLENGES": ["passkey_challenge:*"],
      "PROJECT_METADATA": ["project_metadata:*"],
      "SAFE_ALL": ["rate_limit:*", "passkey_challenge:*", "project_metadata:*"]
    }
  },
  "account": {
    "default_full_name": "Người dùng Veriq",
