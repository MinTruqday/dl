{
  "configuration": {
    "maximum_key_characters": 100,
    "sensitive_key_markers": ["secret", "token", "password", "credential"]
  },
  "ai": {
    "model_update_allowed_keys": [
      "enabled",
      "version",
      "capabilities",
      "model",
      "provider_id"
    ],
    "default_allowed_keys": [
      "chat_model_id",
      "structured_model_id",
      "fallback_model_ids",
      "timeout_seconds",
      "max_output_tokens",
      "concurrency"
    ],
    "primary_model_reference_keys": ["chat_model_id", "structured_model_id"]
  },
  "operations": {
    "platform_health_services": ["authentication", "testing", "worker", "ai", "content"],
    "integration_health_services": ["worker", "ai", "cloud", "testing"],
    "audit_export_maximum_records": 100000,
    "background_job_failed_status": "failed",
    "unavailable_status": "unavailable",
    "ready_status": "ready",
    "mongodb_service": "mongodb",
    "job_actions": {
      "retry": "thu-lai",
      "cancel": "huy"
    },
    "audit_actions": {
      "jobs_viewed": "ADMIN_OPERATIONS_JOBS_VIEWED",
      "job_retried": "ADMIN_OPERATIONS_JOB_RETRIED",
      "job_canceled": "ADMIN_OPERATIONS_JOB_CANCELED",
      "dead_letter_discarded": "ADMIN_DLQ_JOB_DISCARDED",
